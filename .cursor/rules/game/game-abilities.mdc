# Game Abilities System Guidelines

## Overview
This document provides a comprehensive guide for implementing a progressive ability system in a Metroidvania-style mobile web game, focusing on ability acquisition, progression mechanics, and integration with game systems.

## Ability System Architecture

### Core Principles
- **Progressive Unlocks**: Abilities should be acquired in a strategic order that gradually expands gameplay possibilities
- **Traversal Gates**: Use abilities as keys to gate different areas of the game world
- **Organic Discovery**: Abilities should feel like natural extensions of the core mechanics
- **Meaningful Choices**: Allow for different playstyles based on ability combinations

### Ability Types

1. **Movement Abilities**
   - Modify player mobility and world traversal
   - Examples: double jump, wall climb, dash, grapple hook

2. **Combat Abilities**
   - Enhance the player's offensive and defensive capabilities
   - Examples: charged attack, projectile attacks, area effects

3. **Utility Abilities**
   - Provide non-combat advantages and environment manipulation
   - Examples: light source, phase through barriers, manipulate objects

## Implementation Structure

### Base Ability Class

```javascript
// src/lib/game/abilities/ability-base.js
export class Ability {
  constructor(config = {}) {
    this.id = config.id || 'ability';
    this.name = config.name || 'Unnamed Ability';
    this.description = config.description || '';
    this.icon = config.icon || 'default-ability-icon.png';
    this.unlocked = config.unlocked || false;
    this.cooldown = config.cooldown || 0; // ms
    this.energyCost = config.energyCost || 0;
    this.level = config.level || 1;
    this.maxLevel = config.maxLevel || 3;
    this.effects = config.effects || [];
    
    // State tracking
    this.lastUsedTime = 0;
    this.isActive = false;
    this.activeStartTime = 0;
    this.activeDuration = config.activeDuration || 0; // 0 means instant
  }
  
  canUse(player) {
    if (!this.unlocked) return false;
    
    const now = performance.now();
    const isOffCooldown = now - this.lastUsedTime >= this.cooldown;
    const hasEnoughEnergy = player.energy >= this.energyCost;
    
    return isOffCooldown && hasEnoughEnergy && !this.isActive;
  }
  
  use(player, ...args) {
    if (!this.canUse(player)) return false;
    
    // Record usage
    this.lastUsedTime = performance.now();
    
    // Apply energy cost
    player.energy -= this.energyCost;
    
    // Handle duration-based abilities
    if (this.activeDuration > 0) {
      this.isActive = true;
      this.activeStartTime = this.lastUsedTime;
      
      // Set up automatic deactivation
      setTimeout(() => {
        this.deactivate(player);
      }, this.activeDuration);
    }
    
    // Execute ability-specific activation logic
    this.activate(player, ...args);
    
    return true;
  }
  
  // To be overridden by specific abilities
  activate(player, ...args) {
    // Default implementation does nothing
  }
  
  deactivate(player) {
    if (!this.isActive) return;
    
    this.isActive = false;
    
    // Execute ability-specific deactivation logic
    this.onDeactivate(player);
  }
  
  // To be overridden by specific abilities
  onDeactivate(player) {
    // Default implementation does nothing
  }
  
  upgrade() {
    if (this.level < this.maxLevel) {
      this.level++;
      return true;
    }
    return false;
  }
  
  getUpgradeInfo() {
    if (this.level >= this.maxLevel) {
      return null; // Already at max level
    }
    
    return {
      nextLevel: this.level + 1,
      improvements: this.getImprovementsForLevel(this.level + 1)
    };
  }
  
  // To be overridden by specific abilities
  getImprovementsForLevel(level) {
    return [`Level ${level} improvements`];
  }
}
```

### Specific Ability Implementation

```javascript
// src/lib/game/abilities/movement.js
import { Ability } from './ability-base';

export class DashAbility extends Ability {
  constructor(config = {}) {
    super({
      id: 'dash',
      name: 'Dash',
      description: 'Quickly dash forward in the direction you're facing',
      icon: 'dash-icon.png',
      cooldown: 1500, // 1.5 seconds
      energyCost: 20,
      ...config
    });
    
    // Dash-specific properties
    this.distance = config.distance || 200; // px
    this.speed = config.speed || 1200; // px/s
    this.iFrames = config.iFrames || 0.2; // seconds of invulnerability
  }
  
  activate(player, direction = { x: 1, y: 0 }) {
    // Normalize direction vector
    const magnitude = Math.sqrt(direction.x * direction.x + direction.y * direction.y);
    if (magnitude === 0) return; // No direction, no dash
    
    const normalizedDir = {
      x: direction.x / magnitude,
      y: direction.y / magnitude
    };
    
    // Apply dash
    player.velocity.x = normalizedDir.x * this.speed;
    player.velocity.y = normalizedDir.y * this.speed;
    
    // Apply invulnerability frames
    player.setInvulnerable(this.iFrames * 1000);
    
    // Trigger visual effects
    player.effects.createDashEffect(normalizedDir);
    
    // Trigger sound effect
    player.audio.play('dash');
  }
  
  getImprovementsForLevel(level) {
    switch (level) {
      case 2:
        return [
          'Increased dash distance by 25%',
          'Reduced cooldown to 1.2 seconds'
        ];
      case 3:
        return [
          'Dash can now pass through certain barriers',
          'Grants 0.3 seconds of invulnerability'
        ];
      default:
        return [];
    }
  }
}

export class WallClimbAbility extends Ability {
  constructor(config = {}) {
    super({
      id: 'wallClimb',
      name: 'Wall Climb',
      description: 'Attach to and climb vertical surfaces',
      icon: 'wall-climb-icon.png',
      energyCost: 1, // per tick of climbing
      ...config
    });
    
    // Wall climb specific properties
    this.climbSpeed = config.climbSpeed || 150; // px/s
    this.maxClimbTime = config.maxClimbTime || 3000; // ms
    this.slideFactor = config.slideFactor || 0.2; // How fast the player slides down
  }
  
  activate(player) {
    // This ability doesn't use the active duration built-in system
    // since it's controlled by player input and wall contact
    
    // Simply mark as active - deactivation happens in game loop
    // when the player lets go or runs out of energy
    this.isActive = true;
    
    // Apply wall climbing physics
    player.physics.applyWallClimbing(this.climbSpeed, this.slideFactor);
    
    // Trigger visual effects
    player.effects.createWallClimbEffect();
    
    // Trigger sound effect
    player.audio.play('wallGrab');
  }
  
  update(player, deltaTime) {
    if (!this.isActive) return;
    
    // Check if player is still on a wall
    if (!player.isNearWall) {
      this.deactivate(player);
      return;
    }
    
    // Consume energy while climbing
    const energyUsage = this.energyCost * (deltaTime / 1000);
    player.energy -= energyUsage;
    
    // If no energy left, deactivate
    if (player.energy <= 0) {
      player.energy = 0;
      this.deactivate(player);
    }
  }
  
  onDeactivate(player) {
    // Remove wall climbing physics
    player.physics.removeWallClimbing();
    
    // Trigger sound effect
    player.audio.play('wallRelease');
  }
  
  getImprovementsForLevel(level) {
    switch (level) {
      case 2:
        return [
          'Reduced energy consumption by 25%',
          'Increased climb speed by 20%'
        ];
      case 3:
        return [
          'Jump off walls to reach greater heights',
          'Can climb slippery surfaces'
        ];
      default:
        return [];
    }
  }
}
```

### Ability Manager

```javascript
// src/lib/game/abilities/ability-manager.js
import { DashAbility, WallClimbAbility } from './movement';
import { ChargedAttackAbility, GroundPoundAbility } from './combat';
import { PhaseThroughAbility, LightSourceAbility } from './utility';

export class AbilityManager {
  constructor(player) {
    this.player = player;
    this.abilities = new Map();
    
    // Create ability instances
    this.registerAbilities();
    
    // Track unlocked abilities for UI and gameplay
    this.unlockedCount = 0;
    this.latestUnlock = null;
  }
  
  registerAbilities() {
    // Movement abilities
    this.registerAbility(new DashAbility());
    this.registerAbility(new WallClimbAbility());
    
    // Combat abilities
    this.registerAbility(new ChargedAttackAbility());
    this.registerAbility(new GroundPoundAbility());
    
    // Utility abilities
    this.registerAbility(new PhaseThroughAbility());
    this.registerAbility(new LightSourceAbility());
  }
  
  registerAbility(ability) {
    this.abilities.set(ability.id, ability);
  }
  
  getAbility(abilityId) {
    return this.abilities.get(abilityId);
  }
  
  unlockAbility(abilityId) {
    const ability = this.getAbility(abilityId);
    if (!ability) return false;
    
    if (!ability.unlocked) {
      ability.unlocked = true;
      this.unlockedCount++;
      this.latestUnlock = ability;
      
      // Trigger events
      this.player.events.emit('abilityUnlocked', ability);
      
      return true;
    }
    
    return false;
  }
  
  upgradeAbility(abilityId) {
    const ability = this.getAbility(abilityId);
    if (!ability || !ability.unlocked) return false;
    
    const upgraded = ability.upgrade();
    if (upgraded) {
      // Trigger events
      this.player.events.emit('abilityUpgraded', ability);
    }
    
    return upgraded;
  }
  
  useAbility(abilityId, ...args) {
    const ability = this.getAbility(abilityId);
    if (!ability) return false;
    
    return ability.use(this.player, ...args);
  }
  
  update(deltaTime) {
    // Update all active abilities
    for (const ability of this.abilities.values()) {
      if (ability.isActive) {
        ability.update(this.player, deltaTime);
      }
    }
  }
  
  getUnlockedAbilities() {
    return Array.from(this.abilities.values())
      .filter(ability => ability.unlocked);
  }
  
  getLockedAbilities() {
    return Array.from(this.abilities.values())
      .filter(ability => !ability.unlocked);
  }
  
  serializeState() {
    const state = {};
    
    for (const [id, ability] of this.abilities.entries()) {
      state[id] = {
        unlocked: ability.unlocked,
        level: ability.level,
        lastUsedTime: ability.lastUsedTime
      };
    }
    
    return state;
  }
  
  loadState(state) {
    if (!state) return;
    
    for (const [id, abilityState] of Object.entries(state)) {
      const ability = this.getAbility(id);
      if (ability) {
        ability.unlocked = abilityState.unlocked;
        ability.level = abilityState.level;
        ability.lastUsedTime = abilityState.lastUsedTime;
      }
    }
    
    // Update ability count
    this.unlockedCount = this.getUnlockedAbilities().length;
  }
}
```

## Game World Integration

### Ability Gating

```javascript
// src/lib/game/world/area-manager.js
export class AreaManager {
  constructor(world) {
    this.world = world;
    this.areas = new Map();
    this.gateConditions = new Map();
  }
  
  registerArea(areaId, areaData) {
    this.areas.set(areaId, areaData);
  }
  
  setGateCondition(fromAreaId, toAreaId, condition) {
    const gateKey = `${fromAreaId}->${toAreaId}`;
    this.gateConditions.set(gateKey, condition);
  }
  
  // Set up ability-based gates
  setupAbilityGates(player) {
    // Gate to high ledge areas requires double jump
    this.setGateCondition('initial', 'high_ledges', () => {
      return player.abilities.getAbility('doubleJump')?.unlocked;
    });
    
    // Gate to underground area requires ground pound
    this.setGateCondition('initial', 'underground', () => {
      return player.abilities.getAbility('groundPound')?.unlocked;
    });
    
    // Gate to fortress requires dash
    this.setGateCondition('high_ledges', 'fortress', () => {
      return player.abilities.getAbility('dash')?.unlocked;
    });
    
    // Gate to dark caves requires light source
    this.setGateCondition('underground', 'dark_caves', () => {
      return player.abilities.getAbility('lightSource')?.unlocked;
    });
    
    // Gate to final area requires wall climb and phase through
    this.setGateCondition('fortress', 'final_area', () => {
      return player.abilities.getAbility('wallClimb')?.unlocked &&
             player.abilities.getAbility('phaseThrough')?.unlocked;
    });
  }
  
  canPlayerAccessArea(fromAreaId, toAreaId, player) {
    const gateKey = `${fromAreaId}->${toAreaId}`;
    const condition = this.gateConditions.get(gateKey);
    
    if (!condition) return true; // No condition means free access
    
    return condition(player);
  }
  
  getAreaRequirements(fromAreaId, toAreaId) {
    const area = this.areas.get(toAreaId);
    if (!area) return "Unknown area";
    
    const gateKey = `${fromAreaId}->${toAreaId}`;
    const condition = this.gateConditions.get(gateKey);
    
    if (!condition) return "No special requirements";
    
    // This is a simplification - in a real implementation,
    // you would want to generate hints based on the actual condition logic
    return area.requirementHint || "Requires a special ability";
  }
}
```

### Ability Pickup Items

```javascript
// src/lib/game/entities/ability-pickup.js
import { Entity } from './entity-base';

export class AbilityPickup extends Entity {
  constructor(config) {
    super({
      type: 'pickup',
      width: 48,
      height: 48,
      isInteractive: true,
      ...config
    });
    
    this.abilityId = config.abilityId || 'dash';
    this.isCollected = false;
    this.pulseEffect = 0;
    this.rotationSpeed = config.rotationSpeed || 0.5; // radians per second
    this.rotation = 0;
    this.glowColor = config.glowColor || '#4a80f5';
    
    // Animation config
    this.hoverAmplitude = config.hoverAmplitude || 5;
    this.hoverSpeed = config.hoverSpeed || 2;
    this.hoverOffset = Math.random() * Math.PI * 2; // Random starting phase
  }
  
  update(deltaTime) {
    if (this.isCollected) return;
    
    // Update visual effects
    this.pulseEffect = (this.pulseEffect + deltaTime / 1000) % 1;
    this.rotation += this.rotationSpeed * deltaTime / 1000;
    
    // Apply hover animation
    const hoverTime = performance.now() / 1000 * this.hoverSpeed + this.hoverOffset;
    this.offsetY = Math.sin(hoverTime) * this.hoverAmplitude;
  }
  
  render(ctx) {
    if (this.isCollected) return;
    
    const x = this.position.x;
    const y = this.position.y + this.offsetY;
    
    // Draw glow effect
    const glowSize = 1.2 + Math.sin(this.pulseEffect * Math.PI * 2) * 0.2;
    ctx.globalAlpha = 0.6;
    ctx.beginPath();
    ctx.arc(x, y, this.width/2 * glowSize, 0, Math.PI * 2);
    ctx.fillStyle = this.glowColor;
    ctx.fill();
    
    // Draw the ability icon
    ctx.globalAlpha = 1;
    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(this.rotation);
    ctx.drawImage(
      this.sprite,
      -this.width/2,
      -this.height/2,
      this.width,
      this.height
    );
    ctx.restore();
  }
  
  onInteract(player) {
    if (this.isCollected) return;
    
    // Unlock the ability
    const unlocked = player.abilities.unlockAbility(this.abilityId);
    
    if (unlocked) {
      this.isCollected = true;
      
      // Play effects
      player.audio.play('abilityPickup');
      player.effects.createAbilityPickupEffect(this.position);
      
      // Trigger the ability unlock animation/UI
      player.events.emit('showAbilityUnlockUI', this.abilityId);
      
      return true;
    }
    
    return false;
  }
}
```

## UI Integration

### Ability Unlock Notification

```javascript
// src/lib/components/game/AbilityUnlockNotification.svelte
<script>
  import { onMount } from 'svelte';
  import { tweened } from 'svelte/motion';
  import { cubicOut } from 'svelte/easing';
  import { gameState } from '$lib/stores/game-state';
  
  export let abilityId = '';
  export let duration = 5000; // ms to show the notification
  
  let ability = null;
  let visible = false;
  let timer = null;
  
  const opacity = tweened(0, {
    duration: 800,
    easing: cubicOut
  });
  
  const y = tweened(50, {
    duration: 1000,
    easing: cubicOut
  });
  
  onMount(() => {
    if (abilityId) {
      showUnlock(abilityId);
    }
    
    // Listen for ability unlocks
    const unsubscribe = gameState.subscribe(state => {
      if (state.latestUnlockedAbility && 
          state.latestUnlockedAbility !== abilityId) {
        showUnlock(state.latestUnlockedAbility);
      }
    });
    
    return () => {
      unsubscribe();
      if (timer) clearTimeout(timer);
    };
  });
  
  function showUnlock(id) {
    // Clear any existing timer
    if (timer) clearTimeout(timer);
    
    // Get ability details
    ability = $gameState.abilities.find(a => a.id === id);
    if (!ability) return;
    
    // Show notification
    abilityId = id;
    visible = true;
    opacity.set(1);
    y.set(0);
    
    // Set timer to hide
    timer = setTimeout(() => {
      hideNotification();
    }, duration);
  }
  
  function hideNotification() {
    opacity.set(0);
    y.set(50);
    
    setTimeout(() => {
      visible = false;
    }, 1000);
  }
</script>

{#if visible && ability}
  <div 
    class="ability-unlock-notification"
    style="opacity: {$opacity}; transform: translateY({$y}px);"
  >
    <div class="icon">
      <img src="/assets/abilities/{ability.icon}" alt={ability.name} />
    </div>
    <div class="content">
      <h3>New Ability Unlocked!</h3>
      <h2>{ability.name}</h2>
      <p>{ability.description}</p>
      <div class="controls">
        <span>Press <kbd>Q</kbd> to equip</span>
        <button on:click={hideNotification}>Got it!</button>
      </div>
    </div>
  </div>
{/if}

