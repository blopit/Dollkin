## Context-Sensitive Controls

### Adaptive Behavior System
- Implement a system that adjusts touch control behavior based on game context:
  - Near climbable surface: Hold becomes a climbing action
  - Near interactive object: Tap becomes an interaction
  - During combat: Swipe triggers combat moves

### Context Detection

```javascript
// src/lib/game/core/context-detector.js
export class ContextDetector {
  constructor(world, player) {
    this.world = world;
    this.player = player;
    this.detectionRadius = 100; // px
  }
  
  getPlayerContext() {
    const context = {
      inCombat: false,
      nearLedge: false,
      nearWall: false,
      nearInteractive: false,
      inWater: false,
      onGround: this.player.onGround,
      nearbyEntity: null
    };
    
    // Check if player is in combat
    const enemies = this.world.getEntitiesOfType('enemy');
    context.inCombat = enemies.some(enemy => 
      this.getDistance(this.player.position, enemy.position) < this.detectionRadius
    );
    
    // Check if player is near a climbable wall
    const walls = this.world.getEntitiesOfType('wall');
    context.nearWall = walls.some(wall => 
      this.isNearWall(this.player.position, wall)
    );
    
    // Check if player is near an interactive object
    const interactives = this.world.getEntitiesOfType('interactive');
    const nearbyInteractive = interactives.find(obj => 
      this.getDistance(this.player.position, obj.position) < this.detectionRadius
    );
    
    if (nearbyInteractive) {
      context.nearInteractive = true;
      context.nearbyEntity = nearbyInteractive;
    }
    
    // Check if player is in water
    context.inWater = this.world.isPositionInType(this.player.position, 'water');
    
    // Check if player is near a ledge
    context.nearLedge = this.world.isNearLedge(this.player.position);
    
    return context;
  }
  
  getDistance(pos1, pos2) {
    const dx = pos2.x - pos1.x;
    const dy = pos2.y - pos1.y;
    return Math.sqrt(dx * dx + dy * dy);
  }
  
  isNearWall(playerPos, wall) {
    // Wall-specific proximity detection logic
    // This depends on how walls are represented in your world
    return wall.isNear(playerPos, 20); // 20px proximity check
  }
}
```

### Context-Sensitive Action Mapping

```javascript
// src/lib/game/core/action-mapper.js
export class ActionMapper {
  constructor(player, contextDetector) {
    this.player = player;
    this.contextDetector = contextDetector;
  }
  
  mapTapAction(position) {
    const context = this.contextDetector.getPlayerContext();
    
    // Priority order for tap actions
    if (context.nearInteractive && context.nearbyEntity) {
      return {
        action: 'interact',
        target: context.nearbyEntity
      };
    } else if (context.inCombat) {
      return {
        action: 'attackQuick',
        direction: this.getDirectionToClosestEnemy()
      };
    } else {
      return {
        action: 'basicAction',
        position
      };
    }
  }
  
  mapSwipeAction(direction, velocity) {
    const context = this.contextDetector.getPlayerContext();
    
    // Check player abilities
    const canDash = this.player.abilities.dash;
    
    if (canDash && velocity > 1.2) {
      return {
        action: 'dash',
        direction,
        power: velocity
      };
    } else if (context.nearWall && direction.x > 0.7) {
      return {
        action: 'wallPush',
        direction
      };
    } else {
      return {
        action: 'move',
        direction,
        speed: velocity
      };
    }
  }
  
  mapHoldReleaseAction(chargeLevel, direction) {
    const context = this.contextDetector.getPlayerContext();
    
    // Check player abilities
    const canDoubleJump = this.player.abilities.doubleJump;
    const canChargedAttack = this.player.abilities.chargedAttack;
    
    if (canChargedAttack && chargeLevel > 0.8) {
      return {
        action: 'chargedAttack',
        direction,
        power: chargeLevel
      };
    } else if (context.nearWall && direction.y < -0.5) {
      return {
        action: 'wallClimb',
        height: chargeLevel * 100
      };
    } else if (!context.onGround && canDoubleJump) {
      return {
        action: 'doubleJump',
        direction,
        power: Math.max(0.3, chargeLevel)
      };
    } else {
      return {
        action: 'jump',
        direction,
        power: Math.max(0.3, chargeLevel)
      };
    }
  }
  
  getDirectionToClosestEnemy() {
    // Find closest enemy and return direction to it
    // Implementation depends on world and entity structure
    return { x: 1, y: 0 }; // Placeholder
  }
}
