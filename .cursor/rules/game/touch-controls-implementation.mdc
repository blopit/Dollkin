# Touch Controls Implementation Guidelines

## Overview
This document provides detailed guidelines for implementing intuitive touch controls for a mobile web Metroidvania game, focusing on responsive interactions, visual feedback, and gesture recognition.

## Gesture Recognition System

### Core Touch Events
- Implement handlers for all essential touch events:
  - `touchstart`: Detect initial touch position and time
  - `touchmove`: Track gesture direction and velocity
  - `touchend`: Determine gesture type and execute corresponding action
  - `touchcancel`: Handle interrupted gestures gracefully

### Gesture Classification

```javascript
// src/lib/game/core/input.js
export class GestureRecognizer {
  constructor(options = {}) {
    // Default settings
    this.tapThreshold = options.tapThreshold || 200; // Max ms for a tap
    this.holdThreshold = options.holdThreshold || 300; // Min ms for a hold
    this.swipeThreshold = options.swipeThreshold || 30; // Min px for a swipe
    this.minSwipeVelocity = options.minSwipeVelocity || 0.5; // px/ms
    
    // State tracking
    this.touchStartTime = 0;
    this.touchStartPos = { x: 0, y: 0 };
    this.lastTouchPos = { x: 0, y: 0 };
    this.isHolding = false;
    this.holdTimer = null;
    this.chargeLevel = 0;
    this.maxChargeTime = options.maxChargeTime || 1000; // ms to full charge
    
    // Event callbacks
    this.onTap = options.onTap || (() => {});
    this.onSwipe = options.onSwipe || (() => {});
    this.onHoldStart = options.onHoldStart || (() => {});
    this.onHoldUpdate = options.onHoldUpdate || (() => {});
    this.onHoldRelease = options.onHoldRelease || (() => {});
  }
  
  handleTouchStart(x, y, timestamp) {
    this.touchStartTime = timestamp;
    this.touchStartPos = { x, y };
    this.lastTouchPos = { x, y };
    
    // Start hold detection timer
    this.holdTimer = setTimeout(() => {
      this.isHolding = true;
      this.onHoldStart({
        position: this.touchStartPos,
        duration: timestamp - this.touchStartTime
      });
    }, this.holdThreshold);
    
    return this;
  }
  
  handleTouchMove(x, y, timestamp) {
    const currentPos = { x, y };
    const deltaX = currentPos.x - this.touchStartPos.x;
    const deltaY = currentPos.y - this.touchStartPos.y;
    const distance = Math.sqrt(deltaX * deltaX + deltaY * deltaY);
    
    // If movement exceeds swipe threshold, cancel hold
    if (!this.isHolding && distance > this.swipeThreshold) {
      clearTimeout(this.holdTimer);
    }
    
    // If holding, update charge level
    if (this.isHolding) {
      const holdDuration = timestamp - this.touchStartTime;
      this.chargeLevel = Math.min(1, holdDuration / this.maxChargeTime);
      
      const angle = Math.atan2(deltaY, deltaX);
      this.onHoldUpdate({
        position: currentPos,
        startPosition: this.touchStartPos,
        direction: { x: Math.cos(angle), y: Math.sin(angle) },
        chargeLevel: this.chargeLevel,
        duration: holdDuration
      });
    }
    
    this.lastTouchPos = currentPos;
    return this;
  }
  
  handleTouchEnd(timestamp) {
    clearTimeout(this.holdTimer);
    
    const touchDuration = timestamp - this.touchStartTime;
    const deltaX = this.lastTouchPos.x - this.touchStartPos.x;
    const deltaY = this.lastTouchPos.y - this.touchStartPos.y;
    const distance = Math.sqrt(deltaX * deltaX + deltaY * deltaY);
    const velocity = distance / touchDuration; // px/ms
    
    if (this.isHolding) {
      // Handle hold release
      const angle = Math.atan2(deltaY, deltaX);
      this.onHoldRelease({
        startPosition: this.touchStartPos,
        endPosition: this.lastTouchPos,
        direction: { x: Math.cos(angle), y: Math.sin(angle) },
        chargeLevel: this.chargeLevel,
        duration: touchDuration
      });
    } else if (touchDuration < this.tapThreshold && distance < this.swipeThreshold) {
      // Handle tap
      this.onTap({
        position: this.lastTouchPos,
        duration: touchDuration
      });
    } else if (velocity >= this.minSwipeVelocity) {
      // Handle swipe
      const angle = Math.atan2(deltaY, deltaX);
      this.onSwipe({
        startPosition: this.touchStartPos,
        endPosition: this.lastTouchPos,
        direction: { x: Math.cos(angle), y: Math.sin(angle) },
        distance,
        velocity,
        duration: touchDuration
      });
    }
    
    // Reset state
    this.isHolding = false;
    this.chargeLevel = 0;
    
    return this;
  }
}
```

### Input Handler Integration

```javascript
// src/lib/game/core/input.js
export class InputHandler {
  constructor(canvas, player, world) {
    this.canvas = canvas;
    this.player = player;
    this.world = world;
    this.isEnabled = true;
    
    // Create gesture recognizer
    this.gestureRecognizer = new GestureRecognizer({
      onTap: this.handleTap.bind(this),
      onSwipe: this.handleSwipe.bind(this),
      onHoldStart: this.handleHoldStart.bind(this),
      onHoldUpdate: this.handleHoldUpdate.bind(this),
      onHoldRelease: this.handleHoldRelease.bind(this)
    });
    
    // Initialize event listeners
    this.initEventListeners();
  }
  
  initEventListeners() {
    this.canvas.addEventListener('touchstart', this.onTouchStart.bind(this), { passive: false });
    this.canvas.addEventListener('touchmove', this.onTouchMove.bind(this), { passive: false });
    this.canvas.addEventListener('touchend', this.onTouchEnd.bind(this), { passive: false });
    this.canvas.addEventListener('touchcancel', this.onTouchEnd.bind(this), { passive: false });
  }
  
  onTouchStart(e) {
    if (!this.isEnabled) return;
    e.preventDefault(); // Prevent scrolling
    
    const touch = e.touches[0];
    const rect = this.canvas.getBoundingClientRect();
    const x = touch.clientX - rect.left;
    const y = touch.clientY - rect.top;
    
    this.gestureRecognizer.handleTouchStart(x, y, performance.now());
  }
  
  onTouchMove(e) {
    if (!this.isEnabled) return;
    e.preventDefault();
    
    const touch = e.touches[0];
    const rect = this.canvas.getBoundingClientRect();
    const x = touch.clientX - rect.left;
    const y = touch.clientY - rect.top;
    
    this.gestureRecognizer.handleTouchMove(x, y, performance.now());
  }
  
  onTouchEnd(e) {
    if (!this.isEnabled) return;
    e.preventDefault();
    
    this.gestureRecognizer.handleTouchEnd(performance.now());
  }
  
  // Handler methods that will connect to game actions
  handleTap(data) {
    // Determine what was tapped (enemy, item, etc) using collision detection
    const target = this.world.getEntityAtPosition(data.position);
    
    if (target && target.isInteractive) {
      this.player.interact(target);
    } else {
      this.player.attack(data.position);
    }
  }
  
  handleSwipe(data) {
    // Convert swipe to player movement or dash based on abilities
    this.player.move(data.direction, data.velocity);
  }
  
  handleHoldStart(data) {
    // Begin charge animation
    this.player.startCharging(data.position);
  }
  
  handleHoldUpdate(data) {
    // Update charge animation and direction indicator
    this.player.updateCharging(data.chargeLevel, data.direction);
  }
  
  handleHoldRelease(data) {
    // Execute charged action (jump, attack, etc)
    this.player.releaseCharge(data.chargeLevel, data.direction);
  }
  
  enable() {
    this.isEnabled = true;
  }
  
  disable() {
    this.isEnabled = false;
  }
  
  cleanup() {
    this.canvas.removeEventListener('touchstart', this.onTouchStart);
    this.canvas.removeEventListener('touchmove', this.onTouchMove);
    this.canvas.removeEventListener('touchend', this.onTouchEnd);
    this.canvas.removeEventListener('touchcancel', this.onTouchEnd);
  }
}
```

## Visual Feedback System

### Responsive Visual Cues
- Implement distinct visual effects for each gesture state:
  1. **Tap Feedback**: Simple circle ripple that expands and fades
  2. **Swipe Indicator**: Motion trail following touch path
  3. **Hold Charging**: Growing indicator showing charge level and direction

### Animation Implementation

```javascript
// src/lib/game/utils/feedback.js
export class VisualFeedback {
  constructor(ctx) {
    this.ctx = ctx;
    this.effects = [];
  }
  
  createTapEffect(position) {
    const effect = {
      type: 'tap',
      position,
      radius: 0,
      maxRadius: 50,
      opacity: 1,
      growth: 2.5, // px per frame
      fade: 0.05 // opacity reduction per frame
    };
    
    this.effects.push(effect);
  }
  
  createSwipeEffect(startPos, endPos) {
    const effect = {
      type: 'swipe',
      startPos,
      endPos,
      width: 15,
      opacity: 0.7,
      fade: 0.04
    };
    
    this.effects.push(effect);
  }
  
  createChargeEffect(position, direction, chargeLevel) {
    // Remove any existing charge effects
    this.effects = this.effects.filter(e => e.type !== 'charge');
    
    const effect = {
      type: 'charge',
      position,
      direction,
      chargeLevel, // 0 to 1
      radius: 20 + (chargeLevel * 30),
      opacity: 0.3 + (chargeLevel * 0.5),
      pulseSpeed: 0.05,
      pulseAmount: 0.2,
      pulsePhase: 0
    };
    
    this.effects.push(effect);
  }
  
  update() {
    // Update all active effects
    for (let i = this.effects.length - 1; i >= 0; i--) {
      const effect = this.effects[i];
      
      switch (effect.type) {
        case 'tap':
          effect.radius += effect.growth;
          effect.opacity -= effect.fade;
          
          if (effect.opacity <= 0) {
            this.effects.splice(i, 1);
          }
          break;
          
        case 'swipe':
          effect.opacity -= effect.fade;
          
          if (effect.opacity <= 0) {
            this.effects.splice(i, 1);
          }
          break;
          
        case 'charge':
          effect.pulsePhase += effect.pulseSpeed;
          if (effect.pulsePhase > Math.PI * 2) {
            effect.pulsePhase -= Math.PI * 2;
          }
          break;
      }
    }
  }
  
  render() {
    // Draw all active effects
    for (const effect of this.effects) {
      switch (effect.type) {
        case 'tap':
          this.renderTapEffect(effect);
          break;
          
        case 'swipe':
          this.renderSwipeEffect(effect);
          break;
          
        case 'charge':
          this.renderChargeEffect(effect);
          break;
      }
    }
  }
  
  renderTapEffect(effect) {
    this.ctx.beginPath();
    this.ctx.arc(effect.position.x, effect.position.y, effect.radius, 0, Math.PI * 2);
    this.ctx.strokeStyle = `rgba(255, 255, 255, ${effect.opacity})`;
    this.ctx.lineWidth = 2;
    this.ctx.stroke();
  }
  
  renderSwipeEffect(effect) {
    // Draw trail from start to end
    this.ctx.beginPath();
    this.ctx.moveTo(effect.startPos.x, effect.startPos.y);
    this.ctx.lineTo(effect.endPos.x, effect.endPos.y);
    this.ctx.strokeStyle = `rgba(200, 230, 255, ${effect.opacity})`;
    this.ctx.lineWidth = effect.width;
    this.ctx.lineCap = 'round';
    this.ctx.stroke();
  }
  
  renderChargeEffect(effect) {
    // Calculate pulse modifier
    const pulseMod = Math.sin(effect.pulsePhase) * effect.pulseAmount;
    const radius = effect.radius * (1 + pulseMod);
    
    // Draw circular charge indicator
    this.ctx.beginPath();
    this.ctx.arc(effect.position.x, effect.position.y, radius, 0, Math.PI * 2);
    this.ctx.fillStyle = `rgba(255, 220, 100, ${effect.opacity})`;
    this.ctx.fill();
    
    // Draw direction arrow if direction is defined
    if (effect.direction) {
      const arrowLength = radius * 1.5;
      const endX = effect.position.x + (effect.direction.x * arrowLength);
      const endY = effect.position.y + (effect.direction.y * arrowLength);
      
      this.ctx.beginPath();
      this.ctx.moveTo(effect.position.x, effect.position.y);
      this.ctx.lineTo(endX, endY);
      this.ctx.strokeStyle = `rgba(255, 220, 100, ${effect.opacity + 0.2})`;
      this.ctx.lineWidth = 4;
      this.ctx.lineCap = 'round';
      this.ctx.stroke();
      
      // Draw arrowhead
      const headSize = 15;
      const angle = Math.atan2(effect.direction.y, effect.direction.x);
      this.ctx.beginPath();
      this.ctx.moveTo(endX, endY);
      this.ctx.lineTo(
        endX - headSize * Math.cos(angle - Math.PI/6),
        endY - headSize * Math.sin(angle - Math.PI/6)
      );
      this.ctx.lineTo(
        endX - headSize * Math.cos(angle + Math.PI/6),
        endY - headSize * Math.sin(angle + Math.PI/6)
      );
      this.ctx.closePath();
      this.ctx.fillStyle = `rgba(255, 220, 100, ${effect.opacity + 0.2})`;
      this.ctx.fill();
    }
  }
  
  clear() {
    this.effects = [];
  }
}
```

